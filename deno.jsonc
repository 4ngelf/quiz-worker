{
  "tasks": {
    // esbuild?
    // see: https://docs.deno.com/examples/cloudflare_workers_wrangler_tutorial/#setup-build
    "build:worker": "deno check",
    "build:frontend": "deno npm:vite build",
    "build": {
      "dependencies": ["build:worker", "build:frontend"]
    },

    "dev:worker": "echo DEV WORKER",
    "dev:frontend": "echo DEV FRONTEND",
    "dev": {
      "dependencies": ["dev:worker", "dev:frontend"]
    },

    "deploy": "deno --allow-env --allow-run npm:wrangler deploy",

    // Mantainance tasks
    "lint": "deno lint",
    "fmt": "deno fmt",
    "cf-typegen": "deno --allow-env npm:wrangler types"
  },

  "imports": {
    // Mappings
    "@/": "./",
    "@frontend/": "./src/survey/",
    "@worker/": "./src/worker/",

    // Dependencies
    "solid-js": "npm:solid-js@1.9.14",
    "hono": "npm:hono@4.12.29",
    "zod": "npm:zod@^4.4.3",

    // Development dependencies
    "@cloudflare/vite-plugin": "npm:@cloudflare/vite-plugin@^1.0.0",
    "globals": "npm:globals@^17.0.0",
    "vite": "npm:vite@^6.0.0",
    "vite-plugin-solid": "npm:vite-plugin-solid@2.11.12",
    "wrangler": "npm:wrangler@4.110.0"
    // "@types/node": "24.10.1",
    // "eslint": "^9.0.0",
    // "@eslint/js": "^9.0.0",
    // "typescript": "^5.0.0",
    // "typescript-eslint": "^8.0.0",
  },
  "minimumDependencyAge": {
    "age": "P7D"
  },

  // Codebase standards

  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  }
}
